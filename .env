# ==========================================================
# AeroSense: Environment Configuration
# ==========================================================

# Data Ingestion Mode: 'live' or 'demo'
DATA_MODE=live

# OpenAQ API Key (Enforced by OpenAQ v3)
OPENAQ_API_KEY=

# Database Connection URL (falls back to SQLite at data/aerosense.db if PostgreSQL is unavailable)
DATABASE_URL=sqlite:///data/aerosense.db

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=aerosense-super-secret-key-change-in-production

# Ingestion Scheduling (in minutes)
INGESTION_INTERVAL_MINUTES=15

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501

# Alert Thresholds (PM2.5 in ug/m3)
RISK_THRESHOLD_MODERATE=35.0
RISK_THRESHOLD_HIGH=75.0
RISK_THRESHOLD_CRITICAL=150.0
