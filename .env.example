# ==========================================================
# AeroSense: Environment Configuration Template
# ==========================================================

# Data Ingestion Mode: 'live' or 'demo'
# In 'live' mode, data is pulled from OpenAQ and Open-Meteo APIs.
# In 'demo' mode, calibrated real-world synthetic datasets are loaded for offline testing.
DATA_MODE=demo

# OpenAQ API Key (Optional for basic OpenAQ rate limit tiers, required for high throughput)
OPENAQ_API_KEY=

# Database Connection URL
# For PostgreSQL (Docker or local): postgresql+psycopg2://postgres:postgres@localhost:5432/aerosense
# AeroSense automatically falls back to SQLite (sqlite:///data/aerosense.db) if PostgreSQL is unreachable.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aerosense

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=aerosense-super-secret-key-change-in-production

# Ingestion Scheduling (in minutes)
INGESTION_INTERVAL_MINUTES=60

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501

# Alert Thresholds (PM2.5 in ug/m3)
RISK_THRESHOLD_MODERATE=35.0
RISK_THRESHOLD_HIGH=75.0
RISK_THRESHOLD_CRITICAL=150.0
